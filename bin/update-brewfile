#!/usr/bin/env bash
# update-brewfile - Regenerate Brewfile from currently installed packages
#
# Thin wrapper around `brew bundle dump`, which lists formulae installed on
# request (not `brew leaves`, which misses requested formulae that something
# else also depends on, e.g. bash). Go, npm and Cargo packages are skipped:
# they're managed by mise.
#
# To keep a dependency out of the Brewfile, clear its on-request flag:
#   brew tab --no-installed-on-request <formula>
#
# Usage:
#   update-brewfile              # Updates ~/.dotfiles/Brewfile
#   update-brewfile /path/to/Brewfile

set -euo pipefail

BREWFILE="${1:-$HOME/.dotfiles/Brewfile}"

brew bundle dump --force --no-go --no-npm --no-cargo --file="$BREWFILE"

echo "Brewfile updated: $BREWFILE"

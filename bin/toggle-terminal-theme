#!/usr/bin/env bash
# toggle-terminal-theme - Flip Ghostty + tmux between dark and light,
# independent of macOS system Appearance.
#
# Rewrites the `theme =` line in ghostty/config (Tokyo Night Storm <-> Atom
# One Light — independent families, not tied to each other), updates
# tmux's catppuccin flavor (mocha <-> latte), and sets herdr's
# theme.name directly (see herdr/config.toml's [theme] comment: herdr's
# auto_switch host-detection has a known caching bug on stable 0.8.0 that
# leaves selected/active UI stuck on the old theme, so this sets the name
# explicitly instead and reloads, which takes a different code path).
#
# Ghostty has no CLI/IPC reload hook, so this simulates its own
# Cmd+Shift+, reload-config keybind via System Events. The keybind is
# registered as `global:` in ghostty/config so it fires regardless of
# which app is frontmost when this runs. Requires macOS Accessibility
# permission — granted via a one-time system prompt the first time it runs.
#
# Usage:
#   toggle-terminal-theme          # flip from current state
#   toggle-terminal-theme dark
#   toggle-terminal-theme light

set -euo pipefail

readonly GHOSTTY_CONFIG="$HOME/.dotfiles/ghostty/config"
readonly TMUX_CONFIG="$XDG_CONFIG_HOME/tmux/tmux.conf"
readonly HERDR_CONFIG="$HOME/.dotfiles/herdr/config.toml"

current_mode() {
    if grep -q '^theme = Atom One Light$' "$GHOSTTY_CONFIG"; then
        echo "light"
    else
        echo "dark"
    fi
}

target_mode="${1:-}"
if [[ -z "$target_mode" ]]; then
    if [[ "$(current_mode)" == "dark" ]]; then
        target_mode="light"
    else
        target_mode="dark"
    fi
fi

case "$target_mode" in
    dark)
        ghostty_theme="TokyoNight Storm"
        tmux_flavor="mocha"
        herdr_theme="tokyo-night"
        ;;
    light)
        ghostty_theme="Atom One Light"
        tmux_flavor="latte"
        herdr_theme="one-light"
        ;;
    *)
        echo "Usage: toggle-terminal-theme [dark|light]" >&2
        exit 1
        ;;
esac

sed -i '' "s/^theme = .*/theme = ${ghostty_theme}/" "$GHOSTTY_CONFIG"

if tmux list-sessions &>/dev/null; then
    tmux set -g @catppuccin_flavor "$tmux_flavor" \; source-file "$TMUX_CONFIG"
fi

if [[ -f "$HERDR_CONFIG" ]]; then
    sed -i '' "s/^name = .*/name = \"${herdr_theme}\"/" "$HERDR_CONFIG"
    herdr server reload-config &>/dev/null || true
fi

if osascript -e 'tell application "System Events" to keystroke "," using {command down, shift down}' &>/dev/null; then
    echo "Switched to ${target_mode}: Ghostty -> ${ghostty_theme}, tmux -> ${tmux_flavor}, herdr -> ${herdr_theme} (reloaded)"
else
    echo "Switched to ${target_mode}: Ghostty -> ${ghostty_theme}, tmux -> ${tmux_flavor}, herdr -> ${herdr_theme}"
    echo "Couldn't auto-reload Ghostty — grant Accessibility permission (System Settings > Privacy & Security > Accessibility) and try again, or press Cmd+Shift+, yourself." >&2
fi

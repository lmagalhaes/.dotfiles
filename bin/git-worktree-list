#!/usr/bin/env bash
# git-worktree-list - List all worktrees with enhanced information
#
# Usage: git worktree-list [--status [--no-fetch]]

# Source common functions and variables
source "$(dirname "$0")/git-worktree-common"

readonly BASE_REF="origin/main"

show_help() {
    echo "Usage: git worktree-list [--status [--no-fetch]]"
    echo ""
    echo "List all git worktrees with enhanced information."
    echo ""
    echo "Options:"
    echo "  --status    Add a status line per worktree (uncommitted files,"
    echo "              commits ahead/behind $BASE_REF or merged) and a PR"
    echo "              line (state, review, labels) from gh. Fetches origin"
    echo "              first."
    echo "  --no-fetch  With --status, skip the fetch"
    echo ""
    echo "Features:"
    echo "  - Color-coded output"
    echo "  - Shows current worktree"
    echo "  - Displays allocated ports for each worktree"
    echo ""
    echo "Aliases:"
    echo "  git wt-list"
    echo "  git wt-ls"
}

# "path<TAB>branch" per worktree, branch empty when detached; bare skipped
list_worktree_branches() {
    git worktree list --porcelain | awk '
        /^worktree / { path = substr($0, 10); branch = ""; is_bare = 0 }
        /^branch / { branch = substr($0, 8); sub(/^refs\/heads\//, "", branch) }
        /^bare$/ { is_bare = 1 }
        /^$/ && !is_bare { print path "\t" branch }
    '
}

fetch_origin() {
    git remote get-url origin &>/dev/null || return 0
    git fetch --quiet origin 2>/dev/null \
        || warning "Couldn't fetch origin, status uses the last fetched state" >&2
}

join_with_dots() {
    local joined="$1" part
    shift
    for part in "$@"; do
        joined+=" · $part"
    done
    echo "$joined"
}

uncommitted_status() {
    local count
    count=$(git -C "$1" status --porcelain | wc -l | tr -d ' ')
    if [ "$count" -eq 0 ]; then
        echo "clean"
        return
    fi
    echo "$count uncommitted"
}

# Merges are rebase fast-forward, so a branch with nothing ahead of
# $BASE_REF is merged (or has no commits yet)
branch_status() {
    local branch="$1" ahead behind
    local parts=()
    git rev-parse --verify --quiet "$BASE_REF" >/dev/null || return 0
    read -r behind ahead < <(git rev-list --left-right --count "$BASE_REF...$branch")
    if [ "$branch" != "${BASE_REF#origin/}" ] && [ "$ahead" -eq 0 ]; then
        echo "merged"
        return
    fi
    [ "$ahead" -gt 0 ] && parts+=("$ahead ahead")
    [ "$behind" -gt 0 ] && parts+=("$behind behind")
    if [ ${#parts[@]} -eq 0 ]; then
        echo "up to date"
        return
    fi
    join_with_dots "${parts[@]}"
}

# "#N state[ merge date][, review] [labels]"; the review only while the PR is
# open, the merge date (local) once merged
# shellcheck disable=SC2016 # jq variables, not shell ones
readonly PULL_REQUEST_FORMAT='
    .[]
    | ({APPROVED: "approved", REVIEW_REQUIRED: "pending approval",
        CHANGES_REQUESTED: "changes requested"}[.reviewDecision // ""]) as $review
    | ([(.labels // [])[].name] | join(", ")) as $labels
    | "#\(.number) \(.state | ascii_downcase)"
      + (if .mergedAt then " \(.mergedAt | fromdateiso8601 | strflocaltime("%Y-%m-%d"))" else "" end)
      + (if .state == "OPEN" and $review then ", \($review)" else "" end)
      + (if $labels != "" then " [\($labels)]" else "" end)
'

# The branch's newest PR; empty when detached, when there's none, or when gh
# is missing or fails
pull_request_status() {
    [ -n "$1" ] || return 0
    gh pr list --state all --head "$1" --limit 1 \
        --json number,state,reviewDecision,labels,mergedAt \
        --jq "$PULL_REQUEST_FORMAT" 2>/dev/null || true
}

worktree_status() {
    local path="$1" branch="$2"
    if [ ! -d "$path" ]; then
        echo "missing"
        return
    fi
    local parts=("$(uncommitted_status "$path")")
    if [ -n "$branch" ]; then
        local branch_part
        branch_part=$(branch_status "$branch")
        [ -n "$branch_part" ] && parts+=("$branch_part")
    fi
    join_with_dots "${parts[@]}"
}

# "path<TAB>status<TAB>pull request" per worktree, in list order. Each worktree runs in the
# background: its gh lookup is a network round trip of about a second
worktree_statuses() {
    local results_dir path branch cleanup
    local count=0
    results_dir=$(mktemp -d "${TMPDIR:-/tmp}/git-worktree-list.XXXXXX")
    printf -v cleanup 'rm -rf %q' "$results_dir"
    # shellcheck disable=SC2064 # expand now: results_dir is gone when the trap runs
    trap "$cleanup" EXIT
    while IFS=$'\t' read -r path branch; do
        printf '%s\t%s\t%s\n' "$path" "$(worktree_status "$path" "$branch")" \
            "$(pull_request_status "$branch")" > "$results_dir/$count" &
        count=$((count + 1))
    done < <(list_worktree_branches)
    wait
    local index
    for ((index = 0; index < count; index++)); do
        cat "$results_dir/$index"
    done
}

SHOW_STATUS=false
FETCH=true
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) show_help; exit 0 ;;
        --status) SHOW_STATUS=true ;;
        --no-fetch) FETCH=false ;;
        *) error "Unknown option: $1 (see --help)" ;;
    esac
    shift
done

# Check if in a git repository
check_git_repo

WORKTREE_STATUSES=""
if [ "$SHOW_STATUS" = true ]; then
    [ "$FETCH" = true ] && fetch_origin
    WORKTREE_STATUSES=$(worktree_statuses)
fi
export WORKTREE_STATUSES

# Get repository root - physical path for comparison, logical path for display
REPO_ROOT_PHYSICAL=$(get_repo_root_physical)
REPO_ROOT_LOGICAL=$(get_repo_root_logical)
CURRENT_BRANCH=$(git branch --show-current)

echo ""
echo -e "${BLUE}Git Worktrees${NC}"
echo ""

# Shorten logical path for display (preserves symlinks like ~/workspace/workyard/crew-api)
SHORTENED_REPO_PATH=$(echo "$REPO_ROOT_LOGICAL" | sed -e "s|^$HOME/workspace/lmagalhaes|@lm|" -e "s|^$HOME/workspace/workyard|@wy|" -e "s|^$HOME|~|")

# Parse git worktree list output
git worktree list --porcelain | awk -v repo_root_physical="$REPO_ROOT_PHYSICAL" -v current_branch="$CURRENT_BRANCH" -v shortened_repo_path="$SHORTENED_REPO_PATH" '
BEGIN {
    # Color codes
    GREEN = "\033[0;32m"
    YELLOW = "\033[1;33m"
    CYAN = "\033[0;36m"
    GRAY = "\033[0;90m"
    NC = "\033[0m"

    rows = split(ENVIRON["WORKTREE_STATUSES"], status_rows, "\n")
    for (i = 1; i <= rows; i++) {
        split(status_rows[i], fields, "\t")
        status[fields[1]] = fields[2]
        pull_request[fields[1]] = fields[3]
    }
}

/^worktree / {
    if (worktree != "") {
        print_worktree()
    }
    worktree = substr($0, 10)
    branch = ""
    is_bare = 0
    is_detached = 0
}

/^HEAD / {
    head = substr($0, 6)
}

/^branch / {
    branch = substr($0, 8)
    gsub(/^refs\/heads\//, "", branch)
}

/^bare$/ {
    is_bare = 1
}

/^detached$/ {
    is_detached = 1
}

END {
    if (worktree != "") {
        print_worktree()
    }
}

function print_worktree() {
    # Determine if this is the main worktree or current worktree
    # Note: git worktree list uses physical paths, so compare against physical repo root
    is_main = (worktree == repo_root_physical)
    is_current = (branch == current_branch)

    # Extract worktree name (last path component) for non-main worktrees
    worktree_name = ""
    if (!is_main) {
        split(worktree, path_parts, "/")
        worktree_name = path_parts[length(path_parts)]
    }

    # Build branch display: shortened_repo_path (branch-name)
    branch_display = ""
    current_marker = ""
    if (is_current) {
        current_marker = GREEN " - current" NC
    }

    if (branch != "") {
        branch_display = shortened_repo_path " (" branch ")" current_marker
    }

    # Show worktree name for non-main worktrees
    if (!is_main && worktree_name != "") {
        printf "  %sWorktree:%s %s\n", CYAN, NC, worktree_name
    }

    # Show branch info
    if (branch != "") {
        printf "  %sBranch:%s %s\n", CYAN, NC, branch_display
    } else if (is_detached) {
        printf "  %sDetached HEAD:%s %s\n", CYAN, NC, substr(head, 1, 8)
    }
    if (worktree in status) {
        printf "  %sStatus:%s %s\n", CYAN, NC, status[worktree]
    }
    if (pull_request[worktree] != "") {
        printf "  %sPR:%s %s\n", CYAN, NC, pull_request[worktree]
    }
    printf "\n"
}
'

if [ "$SHOW_STATUS" = false ]; then
    echo -e "  ${GRAY}git wt-list --status adds uncommitted files, ahead/behind and PRs${NC}"
    echo ""
fi

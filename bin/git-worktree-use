#!/usr/bin/env bash
# git-worktree-use - Pick a worktree with fzf and print its path
#
# Usage: git worktree-use [--print-name] [query]

# Source common functions and variables
source "$(dirname "$0")/git-worktree-common"

readonly MAIN_CHECKOUT_NAME="main"
readonly FZF_NO_MATCH=1
readonly NAME_FIELD=1
readonly PATH_FIELD=3

show_help() {
    echo "Usage: git worktree-use [--print-name] [query]"
    echo ""
    echo "Pick a git worktree with fzf and print its path."
    echo ""
    echo "Matches on the worktree folder name and its branch name; the main"
    echo "checkout is listed as '$MAIN_CHECKOUT_NAME'. An exact folder name or a"
    echo "single match is selected without opening the picker."
    echo ""
    echo "Options:"
    echo "  --print-name   Print the folder name instead of the path (tab completion)"
    echo ""
    echo "Examples:"
    echo "  git wt-use"
    echo "  git wt-use 3038"
    echo "  cd \"\$(git wt-use 3038)\""
    echo ""
    echo "Aliases:"
    echo "  git wt-use"
}

# Print "path<TAB>branch" per worktree, main checkout first, bare repos skipped
list_worktree_paths_and_branches() {
    git worktree list --porcelain | awk '
        /^worktree / { path = substr($0, 10); branch = "(detached)" }
        /^branch /   { branch = substr($0, 8); sub(/^refs\/heads\//, "", branch) }
        /^bare$/     { path = "" }
        /^$/         { if (path != "") print path "\t" branch; path = "" }
    '
}

worktree_name() {
    local path="$1"
    local physical_root="$2"

    if [[ "$path" == "$physical_root" ]]; then
        echo "$MAIN_CHECKOUT_NAME"
        return
    fi
    basename "$path"
}

# git reports physical paths; keep the symlinked path the repo was entered
# through (e.g. ~/workspace/workyard/crew-api)
to_logical_path() {
    local path="$1"
    local physical_root="$2"
    local logical_root="$3"

    if [[ "$path" != "$physical_root" && "$path" != "$physical_root"/* ]]; then
        echo "$path"
        return
    fi
    echo "${logical_root}${path#"$physical_root"}"
}

# Print "name<TAB>branch<TAB>path" per worktree for the picker
list_worktree_rows() {
    local physical_root logical_root path branch name
    physical_root=$(get_repo_root_physical)
    logical_root=$(get_repo_root_logical)

    while IFS=$'\t' read -r path branch; do
        name=$(worktree_name "$path" "$physical_root")
        printf '%s\t%s\t%s\n' "$name" "$branch" "$(to_logical_path "$path" "$physical_root" "$logical_root")"
    done < <(list_worktree_paths_and_branches)
}

find_row_by_name() {
    local name="$1"

    list_worktree_rows | awk -F '\t' -v name="$name" '$1 == name && !found { print; found = 1 }'
}

# An exact folder name (what tab completion inserts) skips the picker
pick_worktree_row() {
    local query="$1"
    local exact_row
    exact_row=$(find_row_by_name "$query")

    if [[ -n "$exact_row" ]]; then
        echo "$exact_row"
        return
    fi
    list_worktree_rows |
        fzf --height ~40% --layout reverse --delimiter '\t' --with-nth 1,2 \
            --query "$query" --select-1 --exit-0
}

main() {
    local query=""
    local output_field="$PATH_FIELD"

    while (( $# )); do
        case "$1" in
            -h|--help) show_help; exit 0 ;;
            --print-name) output_field="$NAME_FIELD" ;;
            *) query="$1" ;;
        esac
        shift
    done

    check_git_repo

    local selected_row
    local pick_status=0
    selected_row=$(pick_worktree_row "$query") || pick_status=$?

    if (( pick_status == FZF_NO_MATCH )); then
        error "No worktree matches: $query"
    fi
    if (( pick_status != 0 )); then
        exit "$pick_status"
    fi

    # fzf draws on the tty, so stdout holds only the selected field
    cut -f "$output_field" <<< "$selected_row"
}

main "$@"

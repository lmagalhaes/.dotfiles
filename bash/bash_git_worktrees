# shellcheck shell=bash
# Interactive git wrapper: `git wt-use` changes the current shell's directory,
# which the git alias can't do since it runs in a child process; `git
# wt-claude` does the same before starting Claude, so the shell stays in the
# worktree after Claude exits. Inside herdr, a cd also renames the tab after the
# worktree, and --open moves to the worktree's tab instead of moving this shell.
# The rename lives here so scripts calling the commands never rename a tab.
# Every other git command passes straight through.

git() {
    case "${1:-}" in
        wt-use) _git_worktree_cd "${@:2}" ;;
        wt-claude) _git_worktree_cd_then git-worktree-claude "${@:2}" ;;
        *) command git "$@" ;;
    esac
}

_git_worktree_cd() {
    # These print text, not a path
    case "${1:-}" in
        -h|--help|--print-name)
            command git-worktree-use "$@"
            return
            ;;
    esac

    if _git_worktree_opens_tab "$@"; then
        command git-worktree-use "$@"
        return
    fi

    local worktree_path
    worktree_path=$(command git-worktree-use "$@") || return
    cd "$worktree_path" || return
    _git_worktree_name_tab
}

# Outside herdr the scripts ignore --open with a warning, so the cd goes ahead
_git_worktree_opens_tab() {
    _git_worktree_inside_herdr || return 1

    local argument
    for argument in "$@"; do
        [[ "$argument" == "--open" ]] && return 0
    done
    return 1
}

# A failed rename never undoes or fails the cd
_git_worktree_name_tab() {
    _git_worktree_inside_herdr || return 0

    command git-worktree-herdr rename-tab "${PWD##*/}" || true
}

# Same check as inside_herdr in bin/git-worktree-common
_git_worktree_inside_herdr() {
    [[ -n "${HERDR_TAB_ID:-}" && -n "${HERDR_WORKSPACE_ID:-}" ]]
}

# Picks and cds with the query (the first argument that isn't an option),
# then runs <script> --current with the options
_git_worktree_cd_then() {
    local script="$1"
    shift

    if _git_worktree_skips_pick "$@" || _git_worktree_opens_tab "$@"; then
        command "$script" "$@"
        return
    fi

    local query=""
    local options=()
    while (( $# )); do
        case "$1" in
            --prompt) options+=("$1" "${2:-}"); shift ;;
            -*) options+=("$1") ;;
            *) query="$1" ;;
        esac
        shift
    done

    _git_worktree_cd "$query" || return
    command "$script" --current "${options[@]}"
}

# --help prints text and --current already says where to run
_git_worktree_skips_pick() {
    local argument
    for argument in "$@"; do
        case "$argument" in
            -h|--help|--current) return 0 ;;
        esac
    done
    return 1
}

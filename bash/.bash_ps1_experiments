#!/usr/bin/env bash
# PS1 Experiments — source and switch between 8 prompt variants.
# Depends on: _shorten_pwd and __git_ps1 (already loaded from .bashrc)
#
# Usage:
#   source ~/.dotfiles/bash/.bash_ps1_experiments
#   switch_ps1       # list all variants
#   switch_ps1 3     # apply V3: Powerline
#   switch_ps1 0     # restore original _set_ps1

# ── Git helper for variants that build PS1 directly (used by V3) ─────────────

_ps1_git_branch() {
    git rev-parse --git-dir >/dev/null 2>&1 || return
    local branch flags="" red=$'\[\e[0;31m\]' reset=$'\[\e[0m\]'
    branch=$(git symbolic-ref --short HEAD 2>/dev/null) ||
        branch=$(git rev-parse --short HEAD 2>/dev/null) ||
        return
    git diff --quiet 2>/dev/null || flags+="*"
    git diff --cached --quiet 2>/dev/null || flags+="+"
    [ -n "$(git ls-files --others --exclude-standard 2>/dev/null)" ] && flags+="?"
    git rev-parse --verify refs/stash >/dev/null 2>&1 && flags+="%"
    [[ -n "$flags" ]] && printf '%s %s%s%s' "$branch" "$red" "$flags" "$reset" || printf '%s' "$branch"
}

_ps1_git_info() {
    git rev-parse --git-dir >/dev/null 2>&1 || return
    local branch flags=""
    branch=$(git symbolic-ref --short HEAD 2>/dev/null) ||
        branch=$(git rev-parse --short HEAD 2>/dev/null) ||
        return
    git diff --quiet 2>/dev/null || flags+="*"
    git diff --cached --quiet 2>/dev/null || flags+="+"
    [ -n "$(git ls-files --others --exclude-standard 2>/dev/null)" ] && flags+="?"
    git rev-parse --verify refs/stash >/dev/null 2>&1 && flags+="%"
    [[ -n "$flags" ]] && printf '%s (%s)' "$branch" "$flags" || printf '%s' "$branch"
}

# ── Session constants ─────────────────────────────────────────────────────────

# Evaluated once at source time; blank on local sessions
_PS1_SSH_HOST=""
[[ -n "$SSH_CONNECTION" ]] && _PS1_SSH_HOST="@$(hostname -s)"

# ── Command duration ───────────────────────────────────────────────────────────
# DEBUG fires before every simple command. _ps1_timer_on prevents commands
# inside PROMPT_COMMAND from resetting the timer — only the first DEBUG after
# a new prompt (the user's actual command) captures the start time.
# Each variant resets _ps1_timer_on="" as its very last statement.

_ps1_timer_start=$SECONDS
_ps1_timer_on=""

_ps1_preexec() {
    [[ -n "$_ps1_timer_on" ]] && return
    _ps1_timer_start=$SECONDS
    _ps1_timer_on=1
}

trap '_ps1_preexec' DEBUG

_ps1_format_duration() {
    local s=$1
    if   (( s < 60   )); then printf '%ds'     "$s"
    elif (( s < 3600 )); then printf '%dm %ds' $(( s / 60 )) $(( s % 60 ))
    else                      printf '%dh %dm' $(( s / 3600 )) $(( (s % 3600) / 60 ))
    fi
}

# ── V1: Minimal ───────────────────────────────────────────────────────────────
# Line 1: user[@host] path + dim git
# Line 2: [time] [dur] ❯

_set_ps1_v1() {
    local exit_status=$?
    local elapsed=$(( SECONDS - _ps1_timer_start ))
    local NC=$'\[\e[0m\]'
    local cyan=$'\[\e[0;36m\]'
    local dim=$'\[\e[2m\]'
    local green=$'\[\e[0;32m\]'
    local red=$'\[\e[0;31m\]'

    local indicator
    [ $exit_status -eq 0 ] && indicator="${green}❯" || indicator="${red}❯"

    local dur=""
    (( elapsed >= 1 )) && dur=" ${dim}$(_ps1_format_duration "$elapsed")${NC}"

    local pre="${dim}\\u${_PS1_SSH_HOST}${NC} ${cyan}$(_shorten_pwd)${NC}"
    local post="\n${dim}[\\A]${dur}${NC} ${indicator}${NC} "

    if declare -F __git_ps1 >/dev/null 2>&1; then
        __git_ps1 "$pre" "$post" " ${dim}%s${NC}"
    else
        PS1="${pre}${post}"
    fi
    _ps1_timer_on=""
}


            printf '  6  Catppuccin       — matches tmux palette\n'
            printf '  7  Time-aware       — [HH:MM] ● path git ❯\n'
            printf '  8  Breadcrumb       — ~ ❯ dir ❯ subdir git ❯\n'
            printf '  9  Nerd Font Catppuccin — V4 icons + Catppuccin Macchiato palette\n'
            printf ' 10  Nerd Font Tokyo Night — V4 icons + Tokyo Night Storm palette\n'
            printf ' 11  Nerd Font + Bashrc    — V10 layout, ANSI colors from .bashrc\n'
            printf ' 12  Workspace B           — wy ❯ project/relpath + yellow git\n'
            printf ' 13  Workspace C           — wy  project  relpath + yellow git\n'
            printf ' 14  Workspace B+C         — cyan wy > blue project dim  relpath\n'
            printf ' 15  Workspace B+C (tri)   — orange wy triangle project dim  relpath\n'
            printf ' 16  Workspace TN          — V15 + blue relpath, white branch, TN git colors\n'
            ;;
    esac

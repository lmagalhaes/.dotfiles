# ── V3: Powerline ─────────────────────────────────────────────────────────────
# Line 1: user ▶ path ▶ branch — filled arrow segments, 256-color backgrounds
# Line 2: colored ❯
# Uses _ps1_git_branch instead of __git_ps1 for correct segment transitions.

_set_ps1_v3() {
    local exit_status=$?
    local elapsed=$(( SECONDS - _ps1_timer_start ))
    local NC=$'\[\e[0m\]'
    local ARROW=$''

    local dim=$'\[\e[2m\]'
    local s1_bg=$'\[\e[48;5;24m\]'  s1_fg=$'\[\e[38;5;195m\]'  # steel blue / pale cyan
    local s2_bg=$'\[\e[48;5;17m\]'  s2_fg=$'\[\e[38;5;153m\]'  # navy / periwinkle
    local s3_bg=$'\[\e[48;5;22m\]'  s3_fg=$'\[\e[38;5;156m\]'  # forest / mint

    # Arrow colors: fg = leaving segment bg, bg = entering segment bg
    local arr12="${NC}${s2_bg}"$'\[\e[38;5;24m\]'"${ARROW}"
    local arr23="${NC}${s3_bg}"$'\[\e[38;5;17m\]'"${ARROW}"
    local arr3_end="${NC}"$'\[\e[38;5;22m\]'"${ARROW}${NC}"
    local arr2_end="${NC}"$'\[\e[38;5;17m\]'"${ARROW}${NC}"

    local prompt_color
    [ $exit_status -eq 0 ] && prompt_color=$'\[\e[32m\]' || prompt_color=$'\[\e[31m\]'

    local dur=""
    (( elapsed >= 1 )) && dur=" ${dim}$(_ps1_format_duration "$elapsed")${NC}"

    local git_branch
    git_branch="$(_ps1_git_branch)"

    local user_seg=" \\u${_PS1_SSH_HOST} "
    if [ -n "$git_branch" ]; then
        PS1="${s1_bg}${s1_fg}${user_seg}${arr12}${s2_bg}${s2_fg} $(_shorten_pwd) ${arr23}${s3_bg}${s3_fg}  ${git_branch} ${arr3_end}\n${dim}[\\A]${dur}${NC} ${prompt_color}❯${NC} "
    else
        PS1="${s1_bg}${s1_fg}${user_seg}${arr12}${s2_bg}${s2_fg} $(_shorten_pwd) ${arr2_end}\n${dim}[\\A]${dur}${NC} ${prompt_color}❯${NC} "
    fi
    _ps1_timer_on=""
}


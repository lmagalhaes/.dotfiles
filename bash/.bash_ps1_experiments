# ── V16: Workspace + Tokyo Night git status ───────────────────────────────────
# V15 layout (orange ws ▶ project, blue relpath) with white branch and
# per-symbol git status colors from Tokyo Night Storm:
#   * unstaged=red  + staged=green  ? untracked=amber  % stash=cyan

_set_ps1_v16() {
    local exit_status=$?
    local elapsed=$(( SECONDS - _ps1_timer_start ))
    local NC=$'\[\e[0m\]'
    local green=$'\[\e[0;32m\]'
    local red=$'\[\e[0;31m\]'
    local cyan=$'\[\e[0;36m\]'
    local blue=$'\[\e[1;34m\]'
    local white=$'\[\e[0;37m\]'
    local dim=$'\[\e[2m\]'
    local orange=$'\[\e[38;2;255;158;100m\]'
    local orange_dim=$'\[\e[38;2;255;179;128m\]'
    local git_unstaged=$'\[\e[38;2;247;118;142m\]'
    local git_staged=$'\[\e[38;2;158;206;106m\]'
    local git_untracked=$'\[\e[38;2;224;175;104m\]'
    local git_stash=$'\[\e[38;2;115;218;202m\]'
    local BRANCH=$''
    local FOLDER=$''
    local ARROW=$'▶'

    local status_icon
    [ $exit_status -eq 0 ] && status_icon="${green}●" || status_icon="${red}●"

    local dur=""
    (( elapsed >= 1 )) && dur=" ${dim}$(_ps1_format_duration "$elapsed")${NC}"

    local ws proj rel
    IFS=$'\t' read -r ws proj rel <<< "$(_ps1_context)"

    local path_part
    if [[ -n "$ws" && -n "$proj" ]]; then
        path_part="${orange}${ws}${orange_dim} ${ARROW} ${orange}${proj}${NC}"
        if [[ -n "$rel" ]]; then
            path_part+=" ${blue}${FOLDER} ${rel}${NC}"
        else
            path_part+=" ${blue}${FOLDER} /${NC}"
        fi
    elif [[ -n "$ws" ]]; then
        path_part="${orange}${ws}${NC}"
    else
        path_part="${blue}${FOLDER} ${rel}${NC}"
    fi

    local pre="${status_icon} ${green}\\u${dim}${_PS1_SSH_HOST}${NC} ${path_part}"
    local post="\n${dim}[\\A]${dur}${NC} ❯ "

    if git rev-parse --git-dir >/dev/null 2>&1; then
        local branch flags_str=""
        branch=$(git symbolic-ref --short HEAD 2>/dev/null) ||
            branch=$(git rev-parse --short HEAD 2>/dev/null)
        if [[ -n "$branch" ]]; then
            git diff --quiet 2>/dev/null           || flags_str+="${git_unstaged}*${NC}"
            git diff --cached --quiet 2>/dev/null  || flags_str+="${git_staged}+${NC}"
            [ -n "$(git ls-files --others --exclude-standard 2>/dev/null)" ] \
                                                   && flags_str+="${git_untracked}?${NC}"
            git rev-parse --verify refs/stash >/dev/null 2>&1 \
                                                   && flags_str+="${git_stash}%${NC}"
            local git_str="${white}${BRANCH} ${branch}${NC}"
            [[ -n "$flags_str" ]] && git_str+=" ${white}(${NC}${flags_str}${white})${NC}"
            pre+=" ${git_str}"
        fi
    fi

    PS1="${pre}${post}"
    _ps1_timer_on=""
}

# ── Switcher ──────────────────────────────────────────────────────────────────

switch_ps1() {
    local n="${1:-help}"
    case "$n" in
        0) PROMPT_COMMAND=(_set_ps1);    printf 'PS1 → original\n' ;;
        1) PROMPT_COMMAND=(_set_ps1_v1); printf 'PS1 → V1: Minimal\n' ;;
        2) PROMPT_COMMAND=(_set_ps1_v2); printf 'PS1 → V2: Two-line Modern\n' ;;
        3) PROMPT_COMMAND=(_set_ps1_v3); printf 'PS1 → V3: Powerline\n' ;;
        4) PROMPT_COMMAND=(_set_ps1_v4); printf 'PS1 → V4: Nerd Font Heavy\n' ;;
        5) PROMPT_COMMAND=(_set_ps1_v5); printf 'PS1 → V5: Cobalt Match\n' ;;

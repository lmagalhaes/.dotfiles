# ── Workspace context helper ─────────────────────────────
# Prints tab-separated: workspace_short <TAB> project <TAB> relpath
# All empty (\t\tpath) when outside ~/workspace.
# Uses git rev-parse --show-toplevel for worktree-aware relpath.
_ps1_context() {
    local pwd="$PWD"

    if [[ "$pwd" != "$HOME/workspace/"* ]]; then
        printf '\t\t%s' "${pwd/#$HOME/~}"
        return
    fi

    local under="${pwd#$HOME/workspace/}"
    local workspace="${under%%/*}"
    local ws_short
    case "$workspace" in
        lmagalhaes) ws_short="lm" ;;
        workyard)   ws_short="wy" ;;
        *)          ws_short="$workspace" ;;
    esac

    if [[ "$under" != */* ]]; then
        printf '%s\t\t' "$ws_short"
        return
    fi

    local rest="${under#$workspace/}"
    local project="${rest%%/*}"

    if [[ "$rest" != */* ]]; then
        printf '%s\t%s\t' "$ws_short" "$project"
        return
    fi

    local relpath="" git_root
    git_root=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ -n "$git_root" && "$pwd" == "$git_root/"* ]]; then
        relpath="${pwd#$git_root/}"
    else
        relpath="${rest#$project/}"
    fi

    printf '%s\t%s\t%s' "$ws_short" "$project" "$relpath"
}

# ── V12: Workspace B — wy ❯ project/relpath ────────────────────────
# Workspace dim + ❯ separator, then project/relpath in bold blue. Falls back to
# shortened path when outside ~/workspace.

_set_ps1_v12() {
    local exit_status=$?
    local elapsed=$(( SECONDS - _ps1_timer_start ))
    local NC=$'\[\e[0m\]'
    local green=$'\[\e[0;32m\]'
    local red=$'\[\e[0;31m\]'
    local yellow=$'\[\e[0;33m\]'
    local blue=$'\[\e[1;34m\]'
    local dim=$'\[\e[2m\]'
    local BRANCH=$''

    local status_icon
    [ $exit_status -eq 0 ] && status_icon="${green}●" || status_icon="${red}●"

    local dur=""
    (( elapsed >= 1 )) && dur=" ${dim}$(_ps1_format_duration "$elapsed")${NC}"

    local ws proj rel
    IFS=$'\t' read -r ws proj rel <<< "$(_ps1_context)"

    local path_part
    if [[ -n "$ws" && -n "$proj" ]]; then
        local proj_rel="${proj}"
        [[ -n "$rel" ]] && proj_rel+="/${rel}"
        path_part="${dim}${ws} ❯${NC} ${blue}${proj_rel}${NC}"
    elif [[ -n "$ws" ]]; then
        path_part="${dim}${ws}${NC}"
    else
        path_part="${blue}${rel}${NC}"
    fi

    local pre="${status_icon} ${green}\\u${dim}${_PS1_SSH_HOST}${NC} ${path_part}"
    local post="\n${dim}[\\A]${dur}${NC} ❯ "

    local git_info
    git_info="$(_ps1_git_info)"
    [[ -n "$git_info" ]] && pre+=" ${yellow}${BRANCH} ${git_info}${NC}"
    PS1="${pre}${post}"
    _ps1_timer_on=""
}

